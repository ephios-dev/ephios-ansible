{# Plain KEY=VALUE so this works both as a shell `source` (with `set -a`) and as systemd EnvironmentFile=. #}
DEBUG=False

{% if custom_settings_module is defined %}
DJANGO_SETTINGS_MODULE={{ custom_settings_module }}
{% endif %}

DATABASE_URL={{ database_url }}

ALLOWED_HOSTS={{ custom_allowed_hosts|join(",") if custom_allowed_hosts is defined else domain }}
STATIC_URL=/static/
STATIC_ROOT=/var/www/virtual/{{ ansible_user }}/{{ "html" if use_main_documentroot else domain }}/static/
MEDIA_ROOT=/var/www/virtual/{{ ansible_user }}/{{ "html" if use_main_documentroot else domain }}/media/

SITE_URL=https://{{ domain }}

EMAIL_URL=smtp+ssl://{{ smtp_user }}:{{ smtp_password }}@{{ smtp_host }}:465

DEFAULT_FROM_EMAIL={{ smtp_from }}
SERVER_EMAIL={{ smtp_from }}

ADMINS="{{ admin_email }}"

CACHE_URL=redis:///home/{{ ansible_user }}/.redis/sock

DATA_DIR=/home/{{ ansible_user }}/var/ephios/data
VAPID_PRIVATE_KEY_PATH=/home/{{ ansible_user }}/private_key.pem
